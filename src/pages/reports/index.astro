---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";

const reports = (await getCollection("reports", ({ id, data }) =>
  !id.startsWith("_") && (import.meta.env.DEV || !data.draft),
)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
const formatDate = (date: Date) => date.toISOString().slice(0, 10).replaceAll("-", ".");
---

<BaseLayout
  title="Reports"
  description="Independent asset reviews covering backing, holder claims, liquidity and control."
>
  {reports.length > 0 && (
    <div class="entry-list">
      {reports.map((report) => (
        <article class="entry">
          <div class="entry-meta">
            <time datetime={report.data.publishedAt.toISOString()}>
              {formatDate(report.data.publishedAt)}
            </time>
          </div>
          <div>
            <h2><a href={`/reports/${report.id}/`}>
              {report.data.tokenLogo ? <>
                Asset Review: <Image class="token-logo" src={report.data.tokenLogo} alt="" />{" "}
                {report.data.title.slice("Asset Review: ".length)}
              </> : report.data.title}
            </a></h2>
            <p>{report.data.description}</p>
          </div>
        </article>
      ))}
    </div>
  )}
</BaseLayout>
