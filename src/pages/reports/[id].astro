---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const reports = await getCollection("reports", ({ id, data }) =>
    !id.startsWith("_") && (import.meta.env.DEV || !data.draft),
  );
  return reports.map((report) => ({ params: { id: report.id }, props: { report } }));
}

const { report } = Astro.props;
const { Content } = await render(report);
---

<BaseLayout
  title={report.data.title}
  description={report.data.description}
  type="article"
>
  <article class="document prose report">
    <Content />
  </article>
</BaseLayout>
