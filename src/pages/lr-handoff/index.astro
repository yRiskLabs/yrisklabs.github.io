---
import documents from "../../data/lr-handoff-documents.json";

const sectionOrder = [
  "Overview",
  "Transition Memo",
  "Operational State",
  "Processes",
  "Frameworks & Guidelines",
  "Methods",
  "Research",
  "Miscellaneous",
  "Legal Terms",
  "General",
];

const groups = sectionOrder
  .map((section) => ({
    section,
    documents: documents.filter((document) => document.category === section),
  }))
  .filter((group) => group.documents.length > 0);

const initialDocument =
  documents.find((document) => document.title === "Transition Memo") ?? documents[0];
const initialIndex = documents.findIndex((document) => document.id === initialDocument.id);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Searchable internal reader for the LlamaRisk Curve handoff archive."
    />
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
    <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet" />
    <meta name="theme-color" content="#111111" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{initialDocument.title} · LlamaRisk Handoff</title>
    <style>
      :root {
        --paper: #f3f4f5;
        --surface: #f8f9fa;
        --white: #ffffff;
        --ink: #151718;
        --secondary: #596066;
        --quiet: #6e757a;
        --rule: #d8dcdf;
        --strong-rule: #b9bfc4;
        --accent: #0657f9;
        --topbar: #191919;
        --topbar-ink: #f1f0eb;
        --topbar-muted: #92918a;
        --sidebar: #eef0f1;
        --sidebar-ink: #282b2e;
        --sidebar-muted: #5f656a;
        --sidebar-rule: #ced2d5;
        --sidebar-active: #dde1e4;
        --mono: "SF Mono", "SFMono-Regular", ui-monospace, Menlo, Consolas, monospace;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html,
      body {
        height: 100%;
        margin: 0;
        overflow: hidden;
      }

      body {
        min-width: 320px;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--mono);
        font-size: 12px;
        line-height: 1.45;
      }

      button,
      input {
        font: inherit;
      }

      button,
      a,
      input {
        -webkit-tap-highlight-color: transparent;
      }

      button:focus-visible,
      input:focus-visible,
      a:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      .app {
        display: grid;
        grid-template-rows: 58px minmax(0, 1fr);
        height: 100dvh;
      }

      .topbar {
        z-index: 20;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        padding: 0 18px;
        border-bottom: 1px solid #30302f;
        background: var(--topbar);
        color: var(--topbar-ink);
      }

      .identity,
      .topbar-actions,
      .document-actions,
      .crumbs,
      .reader-meta {
        display: flex;
        align-items: center;
      }

      .identity {
        min-width: 0;
        gap: 12px;
      }

      .mark {
        display: grid;
        width: 29px;
        height: 29px;
        flex: 0 0 auto;
        place-items: center;
        border: 1px solid #55544f;
        color: #ffffff;
        font-size: 11px;
        font-weight: 700;
      }

      .identity-copy {
        min-width: 0;
      }

      .eyebrow {
        margin: 0 0 1px;
        color: var(--topbar-muted);
        font-size: 9px;
        letter-spacing: 0.12em;
        line-height: 1.2;
        text-transform: uppercase;
      }

      .identity h1 {
        margin: 0;
        overflow: hidden;
        font-size: 13px;
        font-weight: 550;
        line-height: 1.3;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .topbar-actions {
        flex: 0 0 auto;
        gap: 8px;
      }

      .topbar-note {
        color: var(--topbar-muted);
        font-size: 10px;
      }

      .icon-button,
      .text-button {
        display: inline-flex;
        height: 30px;
        align-items: center;
        justify-content: center;
        border: 1px solid #4a4946;
        border-radius: 0;
        background: transparent;
        color: var(--topbar-ink);
        cursor: pointer;
      }

      .icon-button {
        width: 30px;
        padding: 0;
        font-size: 15px;
      }

      .text-button {
        gap: 7px;
        padding: 0 9px;
        font-size: 10px;
      }

      .icon-button:hover,
      .text-button:hover {
        border-color: #85847e;
        background: #242424;
      }

      .menu-button {
        display: none;
      }

      .workspace {
        display: grid;
        min-height: 0;
        grid-template-columns: 330px minmax(0, 1fr);
      }

      .sidebar {
        display: flex;
        min-height: 0;
        flex-direction: column;
        border-right: 1px solid var(--sidebar-rule);
        background: var(--sidebar);
        color: var(--sidebar-ink);
      }

      .search-wrap {
        padding: 14px;
      }

      .search-box {
        position: relative;
      }

      .search-icon {
        position: absolute;
        top: 50%;
        left: 10px;
        color: var(--sidebar-muted);
        font-size: 12px;
        transform: translateY(-50%);
      }

      .search-input {
        width: 100%;
        height: 36px;
        padding: 0 10px 0 31px;
        border: 1px solid #c5cacf;
        border-radius: 0;
        background: #f7f8f9;
        color: var(--sidebar-ink);
        outline: none;
      }

      .search-input::placeholder {
        color: #687077;
      }

      .search-input:focus {
        border-color: #8d949a;
      }

      .search-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 9px;
        color: var(--sidebar-muted);
        font-size: 9px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .library {
        min-height: 0;
        flex: 1;
        padding: 10px 8px 24px;
        overflow-y: auto;
        scrollbar-color: #aab0b5 transparent;
        scrollbar-width: thin;
      }

      .section {
        margin-bottom: 18px;
      }

      .section[hidden],
      .doc-link[hidden],
      .section-documents[hidden] {
        display: none;
      }

      .section-heading {
        margin: 0 0 5px;
      }

      .section-toggle {
        display: grid;
        width: 100%;
        grid-template-columns: 10px minmax(0, 1fr) auto;
        gap: 5px;
        align-items: center;
        padding: 3px 7px;
        border: 0;
        background: transparent;
        color: var(--sidebar-muted);
        cursor: pointer;
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 0.13em;
        text-align: left;
        text-transform: uppercase;
      }

      .section-toggle:hover {
        color: var(--sidebar-ink);
      }

      .section-chevron {
        color: #8e959a;
        font-size: 8px;
        line-height: 1;
        transition: transform 120ms ease-out;
      }

      .section-toggle[aria-expanded="false"] .section-chevron {
        transform: rotate(-90deg);
      }

      .section-count {
        color: #858b90;
        font-weight: 400;
        letter-spacing: 0;
      }

      .doc-link {
        display: grid;
        width: 100%;
        grid-template-columns: 12px minmax(0, 1fr);
        gap: 7px;
        align-items: start;
        padding: 6px 8px;
        border: 0;
        background: transparent;
        color: #4b5156;
        cursor: pointer;
        font-size: 11px;
        line-height: 1.35;
        text-align: left;
      }

      .doc-link:hover {
        background: #e3e6e8;
        color: var(--sidebar-ink);
      }

      .doc-link[aria-current="page"] {
        background: var(--sidebar-active);
        color: #1c1f21;
      }

      .doc-link[aria-current="page"] .doc-glyph {
        color: var(--accent);
      }

      .doc-glyph {
        color: #90979d;
        line-height: 1.35;
      }

      .empty-search {
        margin: 28px 8px 0;
        padding: 18px 12px;
        border: 1px dashed #aab0b5;
        color: var(--sidebar-muted);
        text-align: center;
      }

      .empty-search[hidden] {
        display: none;
      }

      .reader-shell {
        display: grid;
        min-width: 0;
        min-height: 0;
        grid-template-rows: 66px minmax(0, 1fr);
        background: var(--white);
      }

      .document-bar {
        display: flex;
        min-width: 0;
        align-items: center;
        gap: 16px;
        justify-content: space-between;
        padding: 9px 16px 9px 20px;
        border-bottom: 1px solid var(--rule);
        background: var(--white);
      }

      .document-heading {
        min-width: 0;
      }

      .crumbs {
        gap: 5px;
        margin-bottom: 3px;
        overflow: hidden;
        color: var(--quiet);
        font-size: 9px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        white-space: nowrap;
      }

      .crumbs span {
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .document-title {
        margin: 0;
        overflow: hidden;
        font-size: 14px;
        font-weight: 560;
        line-height: 1.35;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .document-actions {
        flex: 0 0 auto;
        gap: 10px;
      }

      .reader-meta {
        gap: 9px;
        color: var(--quiet);
        font-size: 9px;
        white-space: nowrap;
      }

      .reader-meta .divider {
        width: 1px;
        height: 11px;
        background: var(--rule);
      }

      .document-actions .icon-button,
      .document-actions .text-button {
        border-color: transparent;
        background: #eef0f1;
        color: var(--ink);
      }

      .document-actions .icon-button:hover,
      .document-actions .text-button:hover {
        border-color: transparent;
        background: #e3e6e8;
      }

      .document-actions button:disabled {
        cursor: not-allowed;
        opacity: 0.35;
      }

      .reader-stage {
        min-width: 0;
        min-height: 0;
        padding: 0;
        background: var(--white);
      }

      .reader-frame {
        width: 100%;
        height: 100%;
        border: 0;
        background: var(--white);
      }

      .overlay {
        display: none;
      }

      @media (max-width: 920px) {
        .menu-button {
          display: inline-flex;
        }

        .topbar-note {
          display: none;
        }

        .workspace {
          grid-template-columns: minmax(0, 1fr);
        }

        .sidebar {
          position: fixed;
          z-index: 40;
          top: 58px;
          bottom: 0;
          left: 0;
          width: min(88vw, 340px);
          box-shadow: 16px 0 36px rgb(0 0 0 / 24%);
          transform: translateX(-104%);
          transition: transform 180ms ease-out;
        }

        .sidebar[data-open="true"] {
          transform: translateX(0);
        }

        .overlay {
          position: fixed;
          z-index: 35;
          inset: 58px 0 0;
          display: block;
          border: 0;
          background: rgb(0 0 0 / 34%);
          opacity: 0;
          pointer-events: none;
          transition: opacity 180ms ease-out;
        }

        .overlay[data-open="true"] {
          opacity: 1;
          pointer-events: auto;
        }
      }

      @media (max-width: 620px) {
        .app {
          grid-template-rows: 54px minmax(0, 1fr);
        }

        .topbar {
          padding: 0 10px;
        }

        .mark,
        .eyebrow,
        .copy-label,
        .reader-meta {
          display: none;
        }

        .sidebar,
        .overlay {
          top: 54px;
        }

        .reader-shell {
          grid-template-rows: 60px minmax(0, 1fr);
        }

        .document-bar {
          gap: 8px;
          padding: 8px 8px 8px 12px;
        }

        .document-title {
          font-size: 12px;
        }

        .document-actions {
          gap: 4px;
        }

        .reader-stage {
          padding: 0;
        }

        .reader-frame {
          border-width: 0;
        }
      }
    </style>
  </head>
  <body>
    <div class="app">
      <header class="topbar">
        <div class="identity">
          <button
            class="icon-button menu-button"
            id="menu-button"
            type="button"
            aria-label="Open document library"
            aria-expanded="false"
          >
            ☰
          </button>
          <div class="mark" aria-hidden="true">yR</div>
          <div class="identity-copy">
              <p class="eyebrow">unlisted path · source archive</p>
            <h1>LlamaRisk Handoff</h1>
          </div>
        </div>
        <div class="topbar-actions">
          <span class="topbar-note">51 documents · exported 2026-06-25</span>
          <button class="text-button" id="copy-link" type="button">
            <span aria-hidden="true">⌘</span>
            <span class="copy-label">copy link</span>
          </button>
        </div>
      </header>

      <div class="workspace">
        <aside class="sidebar" id="sidebar" aria-label="Document library">
          <div class="search-wrap">
            <label class="search-box">
              <span class="search-icon" aria-hidden="true">⌕</span>
              <span style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)">
                Search the handoff archive
              </span>
              <input
                class="search-input"
                id="search-input"
                type="search"
                placeholder="Search all documents"
                autocomplete="off"
              />
            </label>
            <div class="search-meta">
              <span id="result-count">51 documents</span>
              <span>/ to search</span>
            </div>
          </div>

          <nav class="library" id="library" aria-label="Handoff documents">
            {
              groups.map((group, groupIndex) => (
                <section class="section" data-section={group.section}>
                  <h2 class="section-heading">
                    <button
                      class="section-toggle"
                      type="button"
                      data-section-toggle
                      aria-expanded="true"
                      aria-controls={`section-documents-${groupIndex}`}
                    >
                      <span class="section-chevron" aria-hidden="true">▼</span>
                      <span>{group.section}</span>
                      <span class="section-count" aria-hidden="true">{group.documents.length}</span>
                    </button>
                  </h2>
                  <div class="section-documents" id={`section-documents-${groupIndex}`}>
                    {group.documents.map((document) => {
                      const index = documents.findIndex((candidate) => candidate.id === document.id);
                      return (
                        <button
                          class="doc-link"
                          type="button"
                          data-doc-id={document.id}
                          data-url={document.url}
                          data-title={document.title}
                          data-breadcrumb={document.breadcrumb.join(" / ")}
                          data-words={document.wordCount}
                          data-index={index}
                          data-search={document.searchText}
                          aria-current={document.id === initialDocument.id ? "page" : undefined}
                          style={`padding-left:${8 + Math.min(document.breadcrumb.length, 2) * 11}px`}
                        >
                          <span class="doc-glyph" aria-hidden="true">
                            {document.id === initialDocument.id ? "▣" : "□"}
                          </span>
                          <span>{document.title}</span>
                        </button>
                      );
                    })}
                  </div>
                </section>
              ))
            }
            <div class="empty-search" id="empty-search" hidden>
              No documents match that search.
            </div>
          </nav>
        </aside>

        <button class="overlay" id="overlay" type="button" aria-label="Close document library"></button>

        <main class="reader-shell">
          <header class="document-bar">
            <div class="document-heading">
              <div class="crumbs" id="breadcrumbs">
                <span>Handoff</span>
                {
                  initialDocument.breadcrumb.map((crumb) => (
                    <>
                      <span aria-hidden="true">/</span>
                      <span>{crumb}</span>
                    </>
                  ))
                }
              </div>
              <h2 class="document-title" id="document-title">{initialDocument.title}</h2>
            </div>
            <div class="document-actions">
              <div class="reader-meta">
                <span id="word-count">{initialDocument.wordCount.toLocaleString()} words</span>
                <span class="divider" aria-hidden="true"></span>
                <span id="position">{initialIndex + 1} / {documents.length}</span>
              </div>
              <button class="icon-button" id="previous-document" type="button" aria-label="Previous document">
                ←
              </button>
              <button class="icon-button" id="next-document" type="button" aria-label="Next document">
                →
              </button>
            </div>
          </header>
          <div class="reader-stage">
            <iframe
              class="reader-frame"
              id="reader-frame"
              name="lr-reader"
              src={initialDocument.url}
              title={initialDocument.title}
              sandbox="allow-same-origin allow-popups allow-popups-to-escape-sandbox"
            ></iframe>
          </div>
        </main>
      </div>
    </div>

    <script is:inline>
      const docButtons = Array.from(document.querySelectorAll(".doc-link"));
      const sections = Array.from(document.querySelectorAll(".section"));
      const sectionToggles = Array.from(document.querySelectorAll("[data-section-toggle]"));
      const sidebar = document.getElementById("sidebar");
      const overlay = document.getElementById("overlay");
      const menuButton = document.getElementById("menu-button");
      const searchInput = document.getElementById("search-input");
      const resultCount = document.getElementById("result-count");
      const emptySearch = document.getElementById("empty-search");
      const frame = document.getElementById("reader-frame");
      const documentTitle = document.getElementById("document-title");
      const breadcrumbs = document.getElementById("breadcrumbs");
      const wordCount = document.getElementById("word-count");
      const position = document.getElementById("position");
      const previousButton = document.getElementById("previous-document");
      const nextButton = document.getElementById("next-document");
      const copyButton = document.getElementById("copy-link");
      let activeIndex = Number(document.querySelector('[aria-current="page"]')?.dataset.index ?? 0);
      let searchActive = false;

      const setSectionOpen = (section, open) => {
        const toggle = section.querySelector("[data-section-toggle]");
        const panel = section.querySelector(".section-documents");
        toggle?.setAttribute("aria-expanded", String(open));
        if (panel) panel.hidden = !open;
      };

      const normalizeReference = (value) => {
        let decoded = value;
        try {
          decoded = decodeURIComponent(value);
        } catch {}

        return decoded
          .replace(/^.*\//, "")
          .replace(/\.(md|html)$/i, "")
          .replaceAll("%2F", "/")
          .replace(/[\[\]:]/g, " ")
          .replace(/\s+/g, " ")
          .trim()
          .toLowerCase();
      };

      const closeSidebar = () => {
        sidebar.dataset.open = "false";
        overlay.dataset.open = "false";
        menuButton.setAttribute("aria-expanded", "false");
      };

      const openSidebar = () => {
        sidebar.dataset.open = "true";
        overlay.dataset.open = "true";
        menuButton.setAttribute("aria-expanded", "true");
      };

      const selectDocument = (button, updateHash = true) => {
        if (!button) return;
        const nextIndex = Number(button.dataset.index);
        const title = button.dataset.title;
        const trail = (button.dataset.breadcrumb || "").split(" / ").filter(Boolean);

        docButtons.forEach((candidate) => {
          const active = candidate === button;
          candidate.setAttribute("aria-current", active ? "page" : "false");
          candidate.querySelector(".doc-glyph").textContent = active ? "▣" : "□";
        });

        const activeSection = button.closest(".section");
        if (activeSection) setSectionOpen(activeSection, true);

        activeIndex = nextIndex;
        frame.src = button.dataset.url;
        frame.title = title;
        documentTitle.textContent = title;
        breadcrumbs.replaceChildren();
        ["Handoff", ...trail].forEach((crumb, index) => {
          if (index > 0) {
            const separator = document.createElement("span");
            separator.textContent = "/";
            separator.setAttribute("aria-hidden", "true");
            breadcrumbs.append(separator);
          }
          const label = document.createElement("span");
          label.textContent = crumb;
          breadcrumbs.append(label);
        });
        wordCount.textContent = `${Number(button.dataset.words).toLocaleString()} words`;
        position.textContent = `${activeIndex + 1} / ${docButtons.length}`;
        previousButton.disabled = activeIndex === 0;
        nextButton.disabled = activeIndex === docButtons.length - 1;
        document.title = `${title} · LlamaRisk Handoff`;
        if (updateHash) history.replaceState(null, "", `#${button.dataset.docId}`);
        closeSidebar();
      };

      docButtons.forEach((button) => {
        button.addEventListener("click", () => selectDocument(button));
      });

      sectionToggles.forEach((toggle) => {
        toggle.addEventListener("click", () => {
          const section = toggle.closest(".section");
          if (!section) return;
          setSectionOpen(section, toggle.getAttribute("aria-expanded") !== "true");
        });
      });

      searchInput.addEventListener("input", () => {
        const terms = searchInput.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
        const hasTerms = terms.length > 0;
        const beganSearch = hasTerms && !searchActive;
        const endedSearch = !hasTerms && searchActive;
        let visibleCount = 0;

        docButtons.forEach((button) => {
          const matches = terms.every((term) => button.dataset.search.includes(term));
          button.hidden = !matches;
          if (matches) visibleCount += 1;
        });

        sections.forEach((section) => {
          const hasMatches = Boolean(section.querySelector(".doc-link:not([hidden])"));
          section.hidden = !hasMatches;

          if (beganSearch) {
            const toggle = section.querySelector("[data-section-toggle]");
            section.dataset.openBeforeSearch = String(toggle?.getAttribute("aria-expanded") === "true");
          }

          if (hasTerms && hasMatches) setSectionOpen(section, true);
          if (endedSearch) setSectionOpen(section, section.dataset.openBeforeSearch !== "false");
        });

        searchActive = hasTerms;
        resultCount.textContent = `${visibleCount} ${visibleCount === 1 ? "document" : "documents"}`;
        emptySearch.hidden = visibleCount !== 0;
      });

      previousButton.addEventListener("click", () => selectDocument(docButtons[activeIndex - 1]));
      nextButton.addEventListener("click", () => selectDocument(docButtons[activeIndex + 1]));
      menuButton.addEventListener("click", () => {
        sidebar.dataset.open === "true" ? closeSidebar() : openSidebar();
      });
      overlay.addEventListener("click", closeSidebar);

      copyButton.addEventListener("click", async () => {
        await navigator.clipboard.writeText(window.location.href);
        const label = copyButton.querySelector(".copy-label");
        const prior = label?.textContent;
        if (label) label.textContent = "copied";
        window.setTimeout(() => {
          if (label) label.textContent = prior;
        }, 1400);
      });

      frame.addEventListener("load", () => {
        const frameDocument = frame.contentDocument;
        if (!frameDocument) return;

        frameDocument.addEventListener("click", (event) => {
          const anchor = event.target instanceof Element ? event.target.closest("a") : null;
          if (!anchor) return;
          const directDocumentId = anchor.dataset.handoffDocId;

          if (directDocumentId) {
            const destination = docButtons.find(
              (button) => button.dataset.docId === directDocumentId,
            );

            if (destination) {
              event.preventDefault();
              selectDocument(destination);
              return;
            }
          }

          const href = anchor.getAttribute("href") || "";
          const looksInternal =
            href.startsWith("https://./") ||
            href.startsWith("./") ||
            /\.(md|html)(#.*)?$/i.test(href);

          if (looksInternal) {
            const reference = normalizeReference(href);
            const label = normalizeReference(anchor.textContent || "");
            const destination = docButtons.find((button) => {
              const title = normalizeReference(button.dataset.title);
              return title === reference || title === label || title.includes(reference) || reference.includes(title);
            });

            if (destination) {
              event.preventDefault();
              selectDocument(destination);
              return;
            }
          }

          if (/^https?:\/\//i.test(anchor.href)) {
            anchor.target = "_blank";
            anchor.rel = "noopener noreferrer";
          }
        });
      });

      document.addEventListener("keydown", (event) => {
        if (
          event.key === "/" &&
          document.activeElement !== searchInput &&
          !["INPUT", "TEXTAREA"].includes(document.activeElement?.tagName)
        ) {
          event.preventDefault();
          if (window.matchMedia("(max-width: 920px)").matches) openSidebar();
          searchInput.focus();
        }
        if (event.key === "Escape") closeSidebar();
      });

      const initialFromHash = docButtons.find(
        (button) => button.dataset.docId === window.location.hash.slice(1),
      );
      selectDocument(initialFromHash || docButtons[activeIndex], false);
    </script>

    <script>
      const readerFrame = document.querySelector<HTMLIFrameElement>("#reader-frame");
      let mermaidLoader: Promise<(typeof import("mermaid"))["default"]> | undefined;
      let renderGeneration = 0;
      let renderSequence = 0;

      const loadMermaid = () => {
        mermaidLoader ??= import("mermaid").then(({ default: mermaid }) => {
          mermaid.initialize({
            startOnLoad: false,
            securityLevel: "strict",
            theme: "base",
            fontFamily: '"SF Mono", "SFMono-Regular", ui-monospace, Menlo, Consolas, monospace',
            flowchart: {
              htmlLabels: true,
              useMaxWidth: true,
            },
            themeVariables: {
              background: "#ffffff",
              primaryColor: "#f3f4f5",
              primaryTextColor: "#151718",
              primaryBorderColor: "#8f969b",
              secondaryColor: "#eef0f1",
              tertiaryColor: "#ffffff",
              lineColor: "#596066",
              edgeLabelBackground: "#ffffff",
            },
          });
          return mermaid;
        });

        return mermaidLoader;
      };

      const addDiagramStyles = (frameDocument: Document) => {
        if (frameDocument.getElementById("yrisk-mermaid-styles")) return;

        const style = frameDocument.createElement("style");
        style.id = "yrisk-mermaid-styles";
        style.textContent = `
          .yrisk-mermaid {
            width: 100%;
            margin: 0.75em 0 1.5em;
            padding: 18px;
            overflow-x: auto;
            border: 1px solid #d8dcdf;
            background: #f8f9fa;
          }

          .yrisk-mermaid svg {
            display: block;
            width: 100% !important;
            height: auto !important;
            max-width: none !important;
            margin: 0 auto;
          }

          .yrisk-mermaid-error::before {
            display: block;
            margin-bottom: 8px;
            color: #8a2f2f;
            content: "Diagram could not be rendered; Mermaid source follows.";
            font-family: "SF Mono", "SFMono-Regular", ui-monospace, Menlo, Consolas, monospace;
            font-size: 11px;
            white-space: normal;
          }
        `;
        frameDocument.head.append(style);
      };

      const renderFrameDiagrams = async () => {
        if (!readerFrame) return;

        const generation = ++renderGeneration;
        const frameDocument = readerFrame.contentDocument;
        if (!frameDocument) return;

        const blocks = Array.from(
          frameDocument.querySelectorAll<HTMLElement>(
            '[data-language="mermaid"], [data-language="mermaidjs"]',
          ),
        );
        if (blocks.length === 0) return;

        addDiagramStyles(frameDocument);
        const mermaid = await loadMermaid();

        for (const [index, block] of blocks.entries()) {
          if (generation !== renderGeneration || readerFrame.contentDocument !== frameDocument) return;

          const source = block.querySelector("code")?.textContent?.trim();
          const staleDiagram = block.nextElementSibling?.matches(".mermaid-diagram-wrapper")
            ? block.nextElementSibling
            : null;
          staleDiagram?.remove();
          if (!source) continue;

          try {
            const id = `handoff-mermaid-${generation}-${index}-${renderSequence++}`;
            const { svg, bindFunctions } = await mermaid.render(id, source);
            if (generation !== renderGeneration || readerFrame.contentDocument !== frameDocument) return;

            const diagram = frameDocument.createElement("div");
            diagram.className = "yrisk-mermaid";
            diagram.innerHTML = svg;
            const svgElement = diagram.querySelector("svg");
            svgElement?.setAttribute("aria-label", "Rendered Mermaid diagram");
            block.replaceWith(diagram);
            bindFunctions?.(diagram);
          } catch (error) {
            block.classList.add("yrisk-mermaid-error");
            console.error("Unable to render Mermaid diagram", error);
          }
        }
      };

      if (readerFrame) {
        readerFrame.addEventListener("load", renderFrameDiagrams);
        if (readerFrame.contentDocument?.readyState === "complete") void renderFrameDiagrams();
      }
    </script>
  </body>
</html>
